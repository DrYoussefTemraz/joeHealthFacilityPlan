# Copy this file to `.env` and fill in the values.
# `.env*` is gitignored; never commit real credentials.

# ---------------------------------------------------------------------------
# Neon / Postgres
# ---------------------------------------------------------------------------
# Use the *direct* (non-pooler) connection string for migrations and seeding.
# DATABASE_URL is the only variable Prisma reads.
DATABASE_URL="postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require"

# Pooled connection string, kept for the deployed serverless runtime.
# DATABASE_URL_POOLED="postgresql://<user>:<password>@<pooler-host>/<database>?sslmode=require"
