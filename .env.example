# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored. Nothing here is read by the app yet.

# ---------------------------------------------------------------------------
# Option A: Prisma + MongoDB (Atlas, or a local replica set)
# ---------------------------------------------------------------------------
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/joehealthplan?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Option B: Appwrite (used through the node-appwrite SDK, not Prisma)
# ---------------------------------------------------------------------------
# APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
# APPWRITE_PROJECT_ID=""
# APPWRITE_API_KEY=""
# APPWRITE_DATABASE_ID=""
# APPWRITE_FACILITIES_COLLECTION_ID=""
# APPWRITE_ZONES_COLLECTION_ID=""
# APPWRITE_PROJECTS_COLLECTION_ID=""
